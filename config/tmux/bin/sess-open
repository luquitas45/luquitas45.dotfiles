#!/usr/bin/env bash
# sess-open <session>: attach to a preset tmux session, building its fixed
# layout the first time it is created (idempotent: attach if it exists).
#
# Presets:
#   SAPE (Yakuake drop-down)
#       1. "terminal" : bare shell in $HOME
#       2. "IA"       : pi in ~/workspace
#   dev  (dev kitty in the Desarrollo desktop)
#       1. "ws"        : paned window in ~/workspace
#            left  : nvim (top) + shell (bottom strip, ~1/5 of the height)
#            right : pi (~1/3 of the width, full height)
#       2. "IA"       : pi in ~/workspace
#
# Used as the Command of the Yakuake profile and by kde/dev-kitty.sh, so the
# fixed sessions materialize exactly when their terminal is opened.
#
# Usage: sess-open <SAPE|dev>
set -uo pipefail

WS="${WS:-$HOME/workspace}"
PI="${PI:-$HOME/.local/bin/pi}"

name="${1:-}"
if [ -z "$name" ]; then
  echo "usage: sess-open <SAPE|dev>" >&2
  exit 2
fi

if ! tmux has-session -t "$name" 2>/dev/null; then
  case "$name" in
    SAPE)
      tmux new-session -d -s SAPE -c "$HOME" >/dev/null
      tmux rename-window -t SAPE:1 terminal >/dev/null
      tmux new-window -t SAPE -n IA -c "$WS" >/dev/null
      tmux send-keys -t SAPE:2.1 "$PI" Enter >/dev/null
      tmux select-window -t SAPE:1 >/dev/null
      ;;
    dev)
      tmux new-session -d -s dev -c "$WS" >/dev/null
      tmux rename-window -t dev:1 ws >/dev/null
      # left column (big): nvim (top) + shell (bottom strip); right (small): pi.
      tmux split-window -h -p 33 -t dev:1 -c "$WS" >/dev/null    # p3 = right column
      tmux split-window -v -p 24 -t dev:1.1 -c "$WS" >/dev/null  # split pane 1 (left) -> p2 shell
      # After the splits the panes land as: 1=left-top, 2=left-bottom, 3=right.
      # Pin the measured proportions the user settled on live (pi = a third of
      # the window width, shell strip = a fifth of the content height; e.g.
      # 100x27 / 100x7 / 50x35 on a 151x36 window). Percentages alone round
      # short on tmux 3.7 (33% -> 49, 20% -> 6), so resize explicitly.
      win_w=$(tmux display-message -p -t dev:1 '#{window_width}')
      win_h=$(tmux display-message -p -t dev:1 '#{window_height}')
      tmux resize-pane -t dev:1.3 -x "$((win_w / 3))" >/dev/null          # right: pi
      tmux resize-pane -t dev:1.2 -y "$(((win_h - 1) / 5))" >/dev/null   # left-bottom: shell
      tmux send-keys -t dev:1.1 nvim Enter >/dev/null     # left-top: editor
      tmux send-keys -t dev:1.3 "$PI" Enter >/dev/null    # right column: pi
      tmux select-pane -t dev:1.1 >/dev/null               # left-bottom (1.2) stays a shell
      tmux new-window -t dev -n IA -c "$WS" >/dev/null
      tmux send-keys -t dev:2.1 "$PI" Enter >/dev/null
      tmux select-window -t dev:1 >/dev/null
      ;;
    *)
      echo "sess-open: unknown session '$name' (SAPE, dev)" >&2
      exit 2
      ;;
  esac
fi

exec tmux new-session -A -s "$name"